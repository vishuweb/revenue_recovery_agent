# Razorpay Test Mode Credentials
# Never commit real secret keys. Use Test Mode credentials only (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional: Next.js Client-Side Public Key ID for Direct Checkout Popup
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Supabase / PostgreSQL Connection String.
# REQUIRED for production (Vercel): business data (customers/payments/
# recovery_cases), AND — as of this fix — the LangGraph agent's checkpoint
# state and long-term memory too (lib/agent/checkpointer.js,
# lib/memory/pgMemory.js). A standalone local SQLite file is NOT a valid
# production store: Vercel's filesystem is read-only outside a
# per-invocation, non-shared /tmp, so agent pause/resume and memory would
# silently fail to persist across requests without this.
#
# Prefer Supabase's POOLED connection string (port 6543, "Connection
# pooling" on the Supabase dashboard, not the direct :5432 one) — the
# agent graph makes many short, sequential queries per case (context load,
# policy checks, checkpoint writes after every step, memory read/write),
# and a pooler measurably reduces per-query overhead versus a direct
# connection under that pattern.
# Format: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-supabase-id.supabase.co:6543/postgres

# --- LangGraph Recovery Agent ---------------------------------------------
# Set to "agent" to route payment.failed cases through the bounded LangGraph
# autonomous agent (lib/agent/graph.js) instead of the deterministic pipeline.
# Leave unset (or anything else) to keep today's deterministic behavior.
RECOVERY_ENGINE=deterministic

# Local LLM (Ollama) used for reasoning-only tasks (root-cause explanation,
# strategy selection among already policy-eligible candidates). Never
# hardcode these — see lib/agent/llm/provider.js. Ollama runs on YOUR
# machine — Vercel cannot reach http://localhost:11434. In production
# without a separately hosted Ollama/LLM endpoint, leave OLLAMA_BASE_URL
# unset/unreachable: the agent fails safely to its deterministic fallback
# (see lib/agent/llm/provider.js) rather than fabricating AI involvement.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LOCAL DEVELOPMENT ONLY — ignored whenever DATABASE_URL is set (see above).
# Where the agent's checkpoint/memory SQLite files live when running
# without Postgres (defaults shown).
AGENT_MEMORY_DB_PATH=./data/agent_memory.db
AGENT_CHECKPOINT_DB_PATH=./data/agent_checkpoints.db

# How long a dispatched-but-unconfirmed action (email, payment link, discount
# offer, etc.) waits before the cron sweep reconsiders the case (default 30
# minutes). Lower this for a live demo — e.g. 5000 (5s) — so paused cases
# become resumable quickly. See lib/agent/nodes/executeAction.js.
AGENT_RECHECK_DELAY_MS=1800000

# Refuses the simulator's destructive "Re-seed Dataset" reset whenever
# DATABASE_URL points at PostgreSQL, unless explicitly set to "true". Exists
# so a demo/reset action can never silently truncate a real Supabase
# instance. Leave unset in production.
ALLOW_DESTRUCTIVE_RESET=false

