# Razorpay Test Mode Credentials
# Never commit real secret keys. Use Test Mode credentials only (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional: Next.js Client-Side Public Key ID for Direct Checkout Popup
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Supabase / PostgreSQL Connection String.
# REQUIRED for production (Vercel): business data (customers/payments/
# recovery_cases), AND — as of this fix — the LangGraph agent's checkpoint
# state and long-term memory too (lib/agent/checkpointer.js,
# lib/memory/pgMemory.js). A standalone local SQLite file is NOT a valid
# production store: Vercel's filesystem is read-only outside a
# per-invocation, non-shared /tmp, so agent pause/resume and memory would
# silently fail to persist across requests without this.
#
# Prefer Supabase's POOLED connection string ("Transaction pooler" mode on
# the Supabase dashboard's Connect panel, not "Direct connection") — the
# agent graph makes many short, sequential queries per case (context load,
# policy checks, checkpoint writes after every step, memory read/write),
# and a pooler measurably reduces per-query overhead versus a direct
# connection under that pattern.
#
# IMPORTANT — the pooled string is NOT just the direct string with the port
# changed to 6543. Supabase's pooler (Supavisor) runs on its own
# region-specific host and requires the username in "postgres.<project-ref>"
# form, not plain "postgres". Copy the connection string EXACTLY as shown
# by Supabase's dashboard for "Transaction pooler" mode — do not hand-edit
# a direct-connection string's port. Using db.<project-ref>.supabase.co
# (the direct host) together with port 6543 and username "postgres" is an
# invalid combination and fails with "password authentication failed for
# user postgres" regardless of whether the password itself is correct.
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-your-region.pooler.supabase.com:6543/postgres

# --- LangGraph Recovery Agent ---------------------------------------------
# Set to "agent" to route payment.failed cases through the bounded LangGraph
# autonomous agent (lib/agent/graph.js) instead of the deterministic pipeline.
# Leave unset (or anything else) to keep today's deterministic behavior.
RECOVERY_ENGINE=deterministic

# LLM used for reasoning-only tasks (root-cause explanation, strategy
# selection among already policy-eligible candidates) — never for money
# calculations, policy, or execution; see lib/agent/llm/provider.js. The
# LLM is always advisory: analyzeFailure.js and decideRecoveryAction.js
# validate its output against a closed schema and fall back to the
# deterministic pipeline on any failure or invalid response.
#
# LLM_PROVIDER selects which backend provider.js talks to:
#   ollama (default) — local only, for development.
#   gemini            — hosted, for production.
# Leave unset to keep today's Ollama-based local behavior.
LLM_PROVIDER=ollama

# --- Local development: Ollama ---------------------------------------------
# Ollama runs on YOUR machine — Vercel cannot reach http://localhost:11434.
# Only read when LLM_PROVIDER=ollama (or unset). In production without a
# separately hosted Ollama endpoint, leave OLLAMA_BASE_URL unset/unreachable
# and set LLM_PROVIDER=gemini instead — provider.js never falls back to
# Ollama on its own, and never attempts to instantiate it when
# LLM_PROVIDER=gemini, so a Gemini-configured deployment can never end up
# silently trying to reach localhost.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Production: Gemini -----------------------------------------------------
# Only read when LLM_PROVIDER=gemini. GEMINI_API_KEY is read server-side
# only (lib/agent/llm/provider.js, not NEXT_PUBLIC_-prefixed) — it is never
# sent to or reachable from client code. gemini-2.0-flash is the default:
# fast/low-latency and well suited to the short, structured JSON
# completions this agent asks for (a one-sentence root-cause note, or a
# single action label from a short candidate list) — a heavier reasoning
# model isn't needed for either task. If GEMINI_API_KEY is missing while
# LLM_PROVIDER=gemini, the agent fails safely to its deterministic
# fallback, exactly like an unreachable Ollama instance.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# LOCAL DEVELOPMENT ONLY — ignored whenever DATABASE_URL is set (see above).
# Where the agent's checkpoint/memory SQLite files live when running
# without Postgres (defaults shown).
AGENT_MEMORY_DB_PATH=./data/agent_memory.db
AGENT_CHECKPOINT_DB_PATH=./data/agent_checkpoints.db

# How long a dispatched-but-unconfirmed action (email, payment link, discount
# offer, etc.) waits before the cron sweep reconsiders the case (default 30
# minutes). Lower this for a live demo — e.g. 5000 (5s) — so paused cases
# become resumable quickly. See lib/agent/nodes/executeAction.js.
AGENT_RECHECK_DELAY_MS=1800000

# Refuses the simulator's destructive "Re-seed Dataset" reset whenever
# DATABASE_URL points at PostgreSQL, unless explicitly set to "true". Exists
# so a demo/reset action can never silently truncate a real Supabase
# instance. Leave unset in production.
ALLOW_DESTRUCTIVE_RESET=false

